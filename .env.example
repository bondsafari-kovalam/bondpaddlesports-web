# Copy to .env.local for local development. Set real values in
# Vercel → Project → Settings → Environment Variables. Never use the NEXT_PUBLIC_ prefix for these.

# Production domain; drives canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Investor portal (single demo administrator)
INVESTOR_ADMIN_USER_ID=
INVESTOR_ADMIN_EMAIL=
# Plain password, or preferably a hash from: node scripts/hash-investor-password.mjs
INVESTOR_ADMIN_PASSWORD=
# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVESTOR_SESSION_SECRET=
